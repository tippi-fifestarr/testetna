# Decibel Trading Starter Kit - Environment Configuration
# Copy this file to .env and fill in your credentials

# ==============================================================================
# REQUIRED: Account Credentials
# ==============================================================================
# Get these from https://testnet-app.decibel.trade/api
# 1. Connect wallet or sign in with Google
# 2. Click "Create API Wallet"
# 3. Copy Private Key and Wallet Address immediately
API_WALLET_PRIVATE_KEY=
API_WALLET_ADDRESS=

# ==============================================================================
# REQUIRED: API Bearer Token
# ==============================================================================
# Get from https://geomi.dev
# 1. Sign up/login and create a project
# 2. Add "API Key" resource
# 3. Select "Decibel Devnet" network
# 4. Copy "Key secret" (Bearer token) from the API Keys table
API_BEARER_TOKEN=

# ==============================================================================
# OPTIONAL: Network Configuration
# ==============================================================================
# NETWORK controls which Aptos network to use. Options: testnet (default), mainnet
# Testnet: free to use, get APT from https://aptos.dev/network/faucet
# Mainnet: real funds, change this only when you're ready to go live
NETWORK=testnet
PACKAGE_ADDRESS=0xe7da2794b1d8af76532ed95f38bfdf1136abfd8ea3a240189971988a83101b7f
FULLNODE_URL=https://api.testnet.aptoslabs.com/v1
REST_API_BASE_URL=https://api.testnet.aptoslabs.com/decibel
WEBSOCKET_URL=wss://api.testnet.aptoslabs.com/decibel/ws

# ==============================================================================
# OPTIONAL: Trading Configuration (set automatically by scripts)
# ==============================================================================
SUBACCOUNT_ADDRESS=
MARKET_ADDRESS=
# Note: MARKET_NAME is configured in src/4-place-order.ts, not in .env
